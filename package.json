{
  "name": "tankmo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "build:native": "tsc -b && vite build --mode native",
    "ios:sync": "npm run build:native && cap sync ios && npm run ios:check",
    "ios:open": "cap open ios",
    "ios:prepare": "npm run ios:sync && cap open ios",
    "ios:check": "node scripts/check-ios.mjs",
    "icons:ios": "node scripts/ios-icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.0",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "fake-indexeddb": "^6.2.0",
    "@playwright/test": "^1.55.0",
    "sharp": "^0.34.4"
  }
}
